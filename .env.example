# Copy this file to ".env" and fill in your values.
# The .env file stays on your computer and is never uploaded to GitHub.

# Cloudflare API token with "Account > Cloudflare Tunnel > Edit" permission
CLOUDFLARE_ACCOUNT_TOKEN=

# Cloudflare API token with "Zone > DNS > Edit" permission for your domain
CLOUDFLARE_DNS_TOKEN=

# Your domain (must be on Cloudflare) and the subdomain for n8n
DOMAIN=example.com
SUBDOMAIN=n8n

# Your timezone, used by n8n schedules
TIMEZONE=Europe/Belgrade

# Filled in automatically by deploy_n8n.py. Leave empty.
N8N_HOST=
TUNNEL_TOKEN=
